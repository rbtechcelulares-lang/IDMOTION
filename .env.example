# ===== ID MOTION — copie para .env (usado pelo app e pelo worker Docker) =====

# Supabase (local: `npx supabase start`; a chave "Secret" aparece no fim do comando / `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Endereço do Supabase visto de dentro do container do worker (opcional)
WORKER_SUPABASE_URL=http://host.docker.internal:54321

# Sessão: segredo aleatório com 32+ caracteres (ex.: `openssl rand -hex 32`)
SESSION_SECRET=
# Opcional: código exigido para criar a senha no primeiro acesso
SETUP_CODE=
# 1 = confiar em X-Forwarded-For para o rate limit por IP (só atrás de proxy reverso)
TRUST_PROXY=0
# 1 = permitir cookie sem HTTPS em produção (ex.: `next start` na rede local)
COOKIE_INSECURE=0

# Armazenamento: local (PC, pasta DATA_DIR) ou supabase (nuvem/Vercel: Supabase Storage, bucket "media")
STORAGE=local
STORAGE_BUCKET=media
# Apaga os arquivos de vídeo após N dias sem atividade (0 = nunca)
RETENTION_DAYS=2
# Arquivos (no modo local, app e worker precisam apontar para a MESMA pasta; no Docker é montada em /data)
DATA_DIR=./data
# No Supabase grátis o limite por arquivo é 50 MB
MAX_UPLOAD_MB=1024
MAX_DURATION_S=600

# AI Director (opcional; sem chave usa o diretor heurístico)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ElevenLabs (opcional): transcrição p/ legendas + narração com cache por hash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
TRANSCRIBE_LANGUAGE=por

# Worker / render
WORKER_POLL_MS=2000
FFMPEG_PRESET=veryfast
FFMPEG_CRF=18
FFMPEG_CRF_FINAL=20
REMOTION_CONCURRENCY=
# Só fora do Docker, se o Chrome do Remotion não puder ser baixado:
REMOTION_BROWSER_EXECUTABLE=
FFMPEG_PATH=
FFPROBE_PATH=
